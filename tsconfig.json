{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2021",
		"rootDir": "./lib",
		"outDir": "build",
		"declaration": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"pretty": true,
		"removeComments": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"lib"
	]
}
