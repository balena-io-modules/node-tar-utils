{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2021",
		"outDir": "build",
		"declaration": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"preserveConstEnums": true,
		"pretty": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": [
		"lib/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
